    "commands/h.js",
    "commands/mu.js",
    "commands/ru.js",
    "commands/daily.js",
    "commands/utility/set-roll.js",
    "lib/gameCharacterLookup.js",
    "lib/characterTrade.js",
    "lib/haremView.js",
    "lib/tradeRuntime.js",
